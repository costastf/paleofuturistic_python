name: Publish

# Runs on every push to the default branch and publishes only when the push carried a release —
# a change of `[project].version` — which `release.ship` decides. Not `push: tags:`: `release`
# creates no tag; this job creates it, on the default branch, once the release has been reviewed
# and merged, so the merge method (merge commit, squash, rebase) cannot leave a tag pointing at a
# commit the branch never saw. The branch is the `default_branch` copier answer. The pipeline the GitLab template ships runs the same command the same way.
on:
  push:
    branches:
      - {{ default_branch }}

# Floor for the workflow; the publish job widens it to what Trusted Publishing needs.
permissions:
  contents: read

jobs:
  build-deps-image:
    uses: ./.github/workflows/build-deps-image.yaml
    permissions:
      contents: read
      packages: write

  publish:
    name: Publish package
    needs: build-deps-image
    runs-on: ubuntu-latest
    permissions:
      # Required for PyPI Trusted Publishing. GitHub Actions only injects
      # ACTIONS_ID_TOKEN_REQUEST_URL / _TOKEN when the job can write OIDC
      # tokens. `release.publish` uses UV_PUBLISH_* credentials whenever they
      # are set; without them it needs this token, and with neither it exits 1.
      id-token: write
      # Declaring any `permissions:` entry flips every other scope to `none`
      # for this job. `write`, not `read`: `release.tag` creates the release
      # tag and its Release entry through the API with GITHUB_TOKEN, which is
      # the Contents scope. The checkout itself persists no credential, so a
      # compromised build step still cannot push.
      contents: write
      # The job runs inside the deps image from ghcr.io. Pulling that image
      # uses GITHUB_TOKEN via the `container.credentials` block; without
      # `packages: read` ghcr returns 403 on the manifest HEAD request.
      # `read` only — `build-deps-image` is the job that publishes.
      packages: read
      # Lets `attest-build-provenance` record the attestation against this repository.
      # It also needs `id-token: write` above to sign, which Trusted Publishing already
      # requires — so provenance costs exactly this one extra scope.
      attestations: write
    container:
      {#- Escape curly braces for Copier. -#}
      {%- raw %}
      image: ${{ needs.build-deps-image.outputs.image }}
      credentials:
        username: ${{ github.actor }}
        password: ${{ secrets.GITHUB_TOKEN }}
      {%- endraw %}
    # Protect this environment by restricting it to the `{{ default_branch }}` branch, not by
    # required reviewers: the job runs on every push to it and exits early without a release, so a
    # reviewer gate would hold every push. The review that guards a release is the pull
    # request's.
    environment: pypi

    steps:
      - name: Checkout
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd  # v6.0.2
        with:
          # Full history: `release.ship` reads pyproject.toml at the previous tip to see
          # whether the version moved.
          fetch-depth: 0
          # Critical in this job specifically: it builds the SBOM, whose VCS reference is
          # read from `origin` and ships inside the wheel to PyPI. A credential left in
          # the git config is the one that becomes permanent and public.
          persist-credentials: false

      # Detect, tag, build, sign PEP 740 attestations, upload — or print why not and exit 0.
      # `dist/` is left in place for the provenance step below. UV_PUBLISH_* select the
      # credential path, and GITHUB_TOKEN is what creates the tag.
      - name: Ship the release, if this push carried one
        id: ship
        env:
          {%- raw %}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          UV_PUBLISH_URL: ${{ secrets.UV_PUBLISH_URL }}
          UV_PUBLISH_PASSWORD: ${{ secrets.UV_PUBLISH_PASSWORD }}
          UV_PUBLISH_USERNAME: ${{ secrets.UV_PUBLISH_USERNAME }}
          {%- endraw %}
        {%- raw %}
        run: ./workflow.cmd release.ship --before "${{ github.event.before }}" --after "${{ github.sha }}" --output "$GITHUB_OUTPUT"
        {%- endraw %}

      # Signs a provenance statement binding the files just uploaded to this workflow,
      # commit and runner, so a consumer can verify where the wheel on PyPI came from:
      #   gh attestation verify <file> --repo <owner>/<repo>
      # Over the wheel and sdist only, not the `.publish.attestation` files beside them. The
      # upload has already happened; the statement is about file contents, so the order does
      # not change what it proves, and `release.ship` leaves `dist/` exactly as uploaded.
      - name: Attest build provenance
        {%- raw %}
        if: ${{ steps.ship.outputs.tag != '' }}
        {%- endraw %}
        uses: actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8  # v4.2.2
        with:
          subject-path: |
            dist/*.whl
            dist/*.tar.gz
