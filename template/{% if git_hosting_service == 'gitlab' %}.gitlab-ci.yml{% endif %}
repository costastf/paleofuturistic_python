stages:
  - deps
  - ci
  - publish

variables:
  # Recommended by uv's GitLab guide — hardlinks can't span GitLab's mount
  # boundaries, so downstream jobs that run `uv run` need copy mode.
  UV_LINK_MODE: copy

# The deps image is content-addressed on the lockfile, the Dockerfile and the base image
# (ADR-0033), and `container.tag` is the one implementation of that address. The job that
# builds the image runs in the kaniko image, which has no Python, so this job computes the
# tag and reads the base image first and hands both on as a dotenv artifact (ADR-0043).
#
# It runs on a plain Python image and installs the uv the project pins, read out of
# pyproject.toml the way copier does at generation. That one line is the only shell the
# launcher cannot replace: the launcher is `uv run`, so uv has to exist before it starts.
plan-deps-image:
  stage: deps
  image: python:3-slim
  variables:
    # The tag needs nothing the project depends on, only the lockfile's bytes, so the
    # launcher runs on an empty environment instead of installing every group first.
    UV_NO_SYNC: "1"
  script:
    - pip install --quiet "uv==$(sed -n 's/^required-version = "==\(.*\)"$/\1/p' pyproject.toml)"
    - ./workflow.cmd container.tag --output .deps-tag.env
  artifacts:
    reports:
      dotenv: .deps-tag.env

build-deps-image:
  stage: deps
  needs:
    - job: plan-deps-image
      artifacts: true
  # Declared so the registry credentials below can be scoped to this environment
  # instead of being readable by every job in the project.
  environment: deps
  # kaniko builds without a daemon, which is what a shared runner allows; docker and
  # podman are not available there. kaniko:debug has no python/uv and its busybox
  # binaries are static, which uv's libc probe refuses, so this is the one pipeline job
  # that can't go through ./workflow.cmd. What it runs by hand is the push itself; the
  # address it pushes to, $DEPS_TAG and $BASE_IMAGE, comes from `container.tag` in the
  # job above. Every other job runs inside $DEPS_IMAGE (built here) where ./workflow.cmd
  # works normally.
  image:
    name: gcr.io/kaniko-project/executor:debug
    entrypoint: [""]
  script:
    # Push to $CI_REGISTRY_IMAGE (the project's registry root) with a
    # deps-prefixed tag. Some registries restrict deploy tokens to the
    # root path only — /deps and -deps subpaths both return DENIED.
    - IMAGE="${CI_REGISTRY_IMAGE}:deps-${DEPS_TAG}"
    - mkdir -p /kaniko/.docker
    # Some registries reject the default CI_JOB_TOKEN for pushes, so this job
    # authenticates with a project Deploy Token (scopes: read_registry +
    # write_registry). Create one at Settings → Repository → Deploy tokens,
    # then expose as protected/masked CI variables DEPS_IMAGE_USERNAME and
    # DEPS_IMAGE_PASSWORD. `container.publish` reads the same two by hand.
    #
    # Mark both Protected and Masked, and set their Environment scope to `deps`
    # (this job's environment) rather than leaving it at `*`. An unscoped variable
    # is readable by every job in every pipeline, including one added by a
    # merge request from a fork, so a registry write token would be reachable from
    # code that has not been reviewed. The publish credentials are scoped the same
    # way via the `pypi` environment on the publish job.
    - '[ -n "$DEPS_IMAGE_USERNAME" ] && echo "DEPS_IMAGE_USERNAME is set" || echo "DEPS_IMAGE_USERNAME EMPTY"'
    - '[ -n "$DEPS_IMAGE_PASSWORD" ] && echo "DEPS_IMAGE_PASSWORD is set" || echo "DEPS_IMAGE_PASSWORD EMPTY"'
    - printf '{"auths":{"%s":{"username":"%s","password":"%s"}}}' "$CI_REGISTRY" "$DEPS_IMAGE_USERNAME" "$DEPS_IMAGE_PASSWORD" > /kaniko/.docker/config.json
    - /kaniko/executor --dockerfile=Dockerfile.deps --context=. --destination="$IMAGE" --build-arg=BASE_IMAGE="$BASE_IMAGE" --digest-file=/tmp/deps-digest
    # Hand downstream jobs a digest rather than the tag, so a tag repointed after
    # this job cannot change the image those jobs run in. kaniko is daemonless, so
    # --digest-file is the only way to learn what it pushed.
    - DIGEST=$(cat /tmp/deps-digest)
    - echo "DEPS_IMAGE=${CI_REGISTRY_IMAGE}@${DIGEST}" > .deps-image.env
    - cat .deps-image.env
  artifacts:
    reports:
      dotenv: .deps-image.env

# One job for the checks, running the same command the pre-push hook does, character for
# character. Verifying is that command's default and writing is opt-in, so there is no flag here
# to keep in step with the hook. Splitting the work across lint, test and build jobs would mean
# two lists of checks that can disagree; the cost of one job is the wall-clock their parallelism
# bought, and `run_scope` still reports every failure in one pass.
#
# Anything failing here would have failed the push: format, lint, ty, the commit messages this
# push adds, the docs build, pyscn, the tox matrix, the wheel, and the badges and coverage
# ratchet matching what the tools measure.
#
# No `--write`: the job has no write access to the repository, so its only useful move is to
# fail and name the command that fixes it.
preflight:
  stage: ci
  image: $DEPS_IMAGE
  needs:
    - job: build-deps-image
      artifacts: true
  before_script:
    - git config --global --add safe.directory "$CI_PROJECT_DIR"
  script:
    - ./workflow.cmd preflight

# Not on every pipeline. An audit's answer depends on the advisory database on the day it runs
# rather than on the branch, so running it everywhere fails merge requests for something the
# author did not introduce and cannot fix — and a pipeline that goes red for reasons outside the
# author's control is one people learn to ignore. The `changes:` rule narrows it to the files
# that can introduce a vulnerable dependency.
#
# A dependency that turns vulnerable while nobody touches it, and `.security-overrides` entries
# coming due, belong to a scheduled pipeline instead: add one under CI/CD → Schedules, which
# `$CI_PIPELINE_SOURCE == "schedule"` below runs the audit for regardless of what changed.
# Publishing is gated separately, `release.dist` auditing before it builds.
secure:
  stage: ci
  image: $DEPS_IMAGE
  needs:
    - job: build-deps-image
      artifacts: true
  rules:
    - if: $CI_PIPELINE_SOURCE == "schedule"
    # `uv.lock` covers every real dependency change: the project runs `--frozen` throughout,
    # so a `pyproject.toml` edit that changes what is installed changes the lockfile with it. A
    # release audits too — `version_provider = "uv"` re-locks, so a bump touches this file.
    # `vendor.txt` is audited by name, the vendored trees having no `.dist-info` for an
    # installed-distribution scan to find. The tree itself is watched so a hand-edited vendored
    # file reaches a human, which is the only thing that can read one.
    - changes:
        - uv.lock
        - _CI/lib/vendor.txt
        - _CI/lib/vendor/**
        - _CI/lib/patches/**
        - .security-overrides
  before_script:
    - git config --global --add safe.directory "$CI_PROJECT_DIR"
  script:
    - ./workflow.cmd secure.audit

# Runs on every push to the default branch and publishes only when the push carried a release —
# a change of `[project].version` — which `release.ship` decides. Not a tag rule: `release`
# creates no tag; this job creates it, on the default branch, once the release has been reviewed
# and merged, so the merge method (merge commit, squash, rebase) cannot leave a tag pointing at a
# commit the branch never saw. `$CI_DEFAULT_BRANCH` is GitLab's own name for it, which the
# `default_branch` copier answer has to match. The workflow the GitHub template ships runs the same command the same way.
publish:
  stage: publish
  image: $DEPS_IMAGE
  needs:
    - job: build-deps-image
      artifacts: true
  rules:
    - if: $CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
  variables:
    # Full history: `release.ship` reads pyproject.toml at the previous tip to see whether the
    # version moved, and the default shallow clone stops twenty commits back.
    GIT_DEPTH: 0
  # Protect this environment by restricting it to the default branch, not by approvers: the
  # job runs on every push to it and exits early without a release, so an approval gate would
  # hold every push. The review that guards a release is the merge request's.
  environment: pypi
  # Two OIDC tokens, one per audience. uv reads `PYPI_ID_TOKEN` and exchanges it for a
  # short-lived PyPI token (Trusted Publishing — register this project, `.gitlab-ci.yml` and
  # the `pypi` environment as a publisher on PyPI first). `pypi-attestations` reads
  # `SIGSTORE_ID_TOKEN` to sign the PEP 740 attestations PyPI shows on the release page.
  # The variable names are fixed by the audiences. See
  # docs/developer/how-to/set-up-trusted-publishing.md.
  id_tokens:
    PYPI_ID_TOKEN:
      aud: pypi
    SIGSTORE_ID_TOKEN:
      aud: sigstore
  before_script:
    - git config --global --add safe.directory "$CI_PROJECT_DIR"
  # Detect, tag (through the Releases API with the job token), build, sign PEP 740
  # attestations, upload — or print why not and exit 0.
  script:
    - ./workflow.cmd release.ship --before "$CI_COMMIT_BEFORE_SHA" --after "$CI_COMMIT_SHA"
