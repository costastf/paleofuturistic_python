# check=skip=InvalidDefaultArgInFrom
# BASE_IMAGE has no default on purpose: every builder passes the digest-pinned image the
# project's uv pin maps to (`container.tag` prints it), and a default would hide a build that
# forgot to. BuildKit warns about the empty default; the directive above silences that one warning.
ARG BASE_IMAGE

# Three stages, so that index credentials never reach the image that is pushed. A build
# argument is recorded in the history of every layer of the stage that declares it, so the
# stage that syncs is thrown away and the final stage copies the environment it produced.
# The arguments are empty for a project that resolves from PyPI; `container.audit` reads the
# pushed image back and fails on any trace of them (ADR-0062).
FROM ${BASE_IMAGE} AS base

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml uv.lock ./

FROM base AS builder

# INDEX_URL names the index the lockfile resolves from; INDEX_USERNAME and INDEX_PASSWORD are
# the credentials for its host. They reach uv through a netrc written for this one command and
# removed in the same layer: never an ENV, never a file that outlives the RUN. uv matches a
# netrc entry by host, so no index name has to be known here.
ARG INDEX_URL
ARG INDEX_USERNAME
ARG INDEX_PASSWORD
RUN if [ -n "$INDEX_PASSWORD" ]; then \
        host="${INDEX_URL#*://}" \
        && printf 'machine %s login %s password %s\n' "${host%%/*}" "$INDEX_USERNAME" "$INDEX_PASSWORD" > /tmp/netrc; \
    fi \
    && env ${INDEX_PASSWORD:+NETRC=/tmp/netrc} uv sync --frozen --all-extras --dev --no-install-project \
    && rm -f /tmp/netrc

FROM base

COPY --from=builder /app/.venv /app/.venv

ENV UV_PROJECT_ENVIRONMENT=/app/.venv
ENV PATH="/app/.venv/bin:$PATH"
# The runner mounts the workspace and the uv cache from other filesystems than this image's
# layers, so hardlinking fails over to copying with a warning on every job; ask for copying.
ENV UV_LINK_MODE=copy

# Drop root. uid 1001 is not arbitrary: it is the uid GitHub's hosted runners own the
# mounted workspace with, and a mismatch would leave that workspace unwritable to the
# job. `/app` has to change hands too — the image is built with `--no-install-project`,
# so `uv run` installs the project into UV_PROJECT_ENVIRONMENT at job time — and uv
# needs a writable HOME for its cache.
RUN useradd --uid 1001 --create-home --shell /bin/bash ci && chown -R 1001:1001 /app
USER 1001
ENV HOME=/home/ci
