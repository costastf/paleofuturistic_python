# `cz bump` takes these as `--prerelease` values on top of a patch increment; the three semver
# increments are passed through as `--increment`.
PRERELEASE_TYPES = ('alpha', 'beta', 'rc')
SEMVER_TYPES = ('major', 'minor', 'patch')


@task
@logged('release.validate')
def validate(context: Context) -> None:
    """Ensure the working tree is clean and in sync with origin before releasing.

    Fails if there are staged, unstaged, or untracked files; if the current
    branch has no upstream configured; or if the local branch is ahead of or
    behind origin after a fetch.
    """
    status = context.run('git status --porcelain', hide=True, warn=True)
    if status.failed:
        print('Could not determine git status.')
        raise SystemExit(1)
    if status.stdout.strip():
        print('Working tree is dirty. Commit, stash, or discard these changes before releasing:')
        print(status.stdout)
        raise SystemExit(1)

    fetch = context.run('git fetch --quiet origin', hide=True, warn=True)
    if fetch.failed:
        print('Could not fetch origin. Check your remote connection before releasing.')
        if fetch.stderr:
            print(fetch.stderr.strip())
        raise SystemExit(1)

    upstream = context.run('git rev-parse --abbrev-ref @{upstream}', hide=True, warn=True)
    if upstream.failed:
        print('Current branch has no upstream configured. Set one with `git push -u origin <branch>` before releasing.')
        raise SystemExit(1)

    counts = context.run('git rev-list --left-right --count @{upstream}...HEAD', hide=True, warn=True)
    if counts.failed:
        print('Could not compare local branch with upstream.')
        raise SystemExit(1)
    behind_str, ahead_str = counts.stdout.strip().split()
    behind, ahead = int(behind_str), int(ahead_str)

    if ahead > 0:
        ahead_log = context.run('git log --oneline @{upstream}..HEAD', hide=True, warn=True)
        print(f'You have {ahead} unpushed commit(s) on this branch. Push them before releasing:')
        if ahead_log.stdout.strip():
            print(ahead_log.stdout.rstrip())
        raise SystemExit(1)

    if behind > 0:
        print(
            f'Your branch is {behind} commit(s) behind `{upstream.stdout.strip()}`. '
            'Pull the latest changes before releasing.'
        )
        raise SystemExit(1)


@task
@logged('release.bump')
def bump(context: Context, increment: str = '') -> None:
    """Bump the version, refresh the version badge, and commit both. No tag.

    `cz bump --version-files-only` moves `pyproject.toml` and `uv.lock` through the uv version
    provider and stops there; this task commits the result with the message `cz bump` would
    have used. The tag is deliberately not created here: it is created on the default branch by
    CI once the release lands there (`release.tag`), so the way the pull request is merged —
    merge commit, squash, rebase — cannot leave a tag pointing at a commit `main` never saw.

    The badge is refreshed *before* the bump, so it lands in the same commit as the version it
    announces: the commit stages every modified tracked file, which is also why `release`
    runs `validate` first to insist on a clean tree. Otherwise the release would land a README
    contradicting the version it released, and the next `preflight` on main would fail on the
    stale badge.

    Writing before the step that can fail means putting the badge back when it does. `cz bump`
    refuses on an unparseable history or an invalid increment, and a badge announcing a version
    nobody released is worse than the failure that caused it. The restore reads the version
    from pyproject.toml, which a failed bump has not touched.

    Args:
        context: Invoke context.
        increment: Version increment type — major, minor, patch, alpha, beta, or rc.

    """
    current = project_version()
    new_version = resolve_next_version(context, increment)
    note(update_package_version_badge(version=new_version))
    try:
        if increment in PRERELEASE_TYPES:
            execute(context, f'uv run cz bump --increment patch --prerelease {increment} --version-files-only --yes')
        else:
            execute(context, f'uv run cz bump --increment {increment} --version-files-only --yes')
    except SystemExit:
        # A failed bump leaves the version in pyproject.toml alone, so writing the badge from
        # pyproject.toml puts back exactly what was there — through the same substitution that
        # changed it, so there is still one writer.
        note(update_package_version_badge())
        print('Version badge restored: the bump it announced did not happen.')
        raise
    execute(context, 'git add --update')
    commit(context, f'bump: version {current} → {new_version}')


@task
@logged('release.changelog')
def changelog(context: Context, write: bool = False, version: str = '') -> None:
    """Generate the changelog from the tags, plus the release being prepared.

    By default prints the changelog to stdout. With --write, adds the new releases to
    ``CHANGELOG_FILE`` (docs/reference/changelog.md, the docs site's changelog page), below its
    header, and commits the result. A file with no releases in it yet gets the whole history.

    The tag for a release in preparation does not exist yet — CI creates it on the default
    branch after the merge — so ``--version`` names it, and the commits since the last tag are
    listed under that heading instead of "Unreleased".

    The commit is signed when ``commit.gpgsign`` is set and a signing key is available, and
    made unsigned with a warning when signing is configured but no key can be reached — which
    is the usual situation in CI. See ``shared.commit``.

    Args:
        context: Invoke context.
        write: Write changelog to file and commit instead of printing to stdout.
        version: The version being released, without the ``v``; its section is generated as
            if the tag existed.

    """
    unreleased = f' --unreleased-version v{version}' if version else ''
    if write:
        execute(context, f'uv run cz changelog{unreleased}')
        execute(context, f'git add {CHANGELOG_FILE}')
        # `git diff --cached --quiet` exits 0 when nothing is staged. Regenerating an
        # already-current changelog is a no-op, not a failure, so this returns rather than
        # letting `git commit` fail on an empty index.
        staged = context.run('git diff --cached --quiet', hide=True, warn=True)
        if staged.ok:
            print('Changelog is already up to date; nothing to commit.')
            return
        commit(context, 'docs: update changelog')
    else:
        execute(context, f'uv run cz changelog --dry-run{unreleased}')


@task
@logged('release.dist')
def dist(context: Context) -> None:
    """Clean and build the distribution artifacts, leaving them in ``dist/``.

    Split out of ``publish`` so a caller can do something with the artifacts *between*
    building and uploading them — CI attests their provenance there. Anything that inspects
    ``dist/`` must run against the exact files that get published, which is why ``publish
    --prebuilt`` exists rather than simply building a second time.

    The dependency audit runs here rather than inside ``build``. Publishing is the moment the
    outside world is exposed to what these dependencies contain, so it is the moment worth
    blocking on a live advisory; merely building a wheel locally is not, and coupling the two
    meant a new CVE could stop a hotfix from being built at all.
    """
    clean(context)
    audit(context)
    build(context)


def distribution_files() -> list[Path]:
    """Return the wheels and sdists in ``dist/``, the files an index accepts as a release."""
    return sorted([*DIST_DIR.glob('*.whl'), *DIST_DIR.glob('*.tar.gz')])


def publishes_with_credentials() -> bool:
    """Report whether ``release.publish`` will upload with ``UV_PUBLISH_*`` rather than OIDC.

    Drops empty ``UV_PUBLISH_*`` values first: GH Actions injects an undefined secret as an
    empty string, and `uv publish` treats UV_PUBLISH_URL="" as an explicit --publish-url with
    no base instead of falling back to PyPI. So empty reads as unset, here and in `uv`.
    """
    for var in UV_PUBLISH_SETTINGS:
        if not os.environ.get(var, '').strip():
            os.environ.pop(var, None)
    return all(os.environ.get(var) for var in UV_PUBLISH_SETTINGS)


@task
@logged('release.attest')
def attest(context: Context) -> None:
    """Sign a PEP 740 attestation for every wheel and sdist in ``dist/``.

    Writes ``<file>.publish.attestation`` beside each one, which ``uv publish`` uploads with the
    file it belongs to. PyPI then shows the publishing workflow on the release page, and anyone
    can check it with ``pypi-attestations verify pypi``.

    The signing identity is the CI job's own OIDC token: ``ACTIONS_ID_TOKEN_*`` on GitHub
    Actions, ``SIGSTORE_ID_TOKEN`` from the publish job's ``id_tokens:`` on GitLab. Run outside
    CI, it opens a browser to sign in to Sigstore instead, which attests to a person rather
    than a workflow — PyPI accepts attestations only from a Trusted Publisher's workflow.

    Skipped when ``UV_PUBLISH_*`` credentials are set: that path uploads with
    ``--no-attestations``, so there is nothing to sign for, and on a host PyPI cannot trust
    (a self-managed GitLab, say) signing would fail the release for no benefit.

    Raises:
        SystemExit: If ``dist/`` holds no wheel or sdist — run ``release.dist`` first — or
            signing fails.

    """
    if publishes_with_credentials():
        print('UV_PUBLISH_* credentials set: release.publish uploads no attestations, so none are signed.')
        return
    files = distribution_files()
    if not files:
        print(f'No wheel or sdist in {DIST_DIR}/; run `./workflow.cmd release.dist` first.')
        raise SystemExit(1)
    execute(context, f'uv run pypi-attestations sign {" ".join(str(path) for path in files)}')


@task
@logged('release.publish')
def publish(context: Context, prebuilt: bool = False) -> None:
    """Build and publish — the full post-release publishing pipeline.

    Credentials decide how it uploads. With ``UV_PUBLISH_*`` set it uses them, and skips any
    attestations in ``dist/``: PyPI accepts attestations only through Trusted Publishing, and
    other indexes may reject the upload outright. Without them it requires an OIDC token and
    publishes through Trusted Publishing, uploading the attestations ``release.attest`` signed.

    Args:
        context: Invoke context.
        prebuilt: Publish what is already in ``dist/`` instead of rebuilding. Set this when an
            earlier step ran ``release.dist`` and acted on those artifacts — rebuilding would
            upload files that no attestation, checksum or signature refers to.

    """
    if not prebuilt:
        dist(context)
    elif not distribution_files():
        print('--prebuilt was given but dist/ is empty; run `./workflow.cmd release.dist` first.')
        raise SystemExit(1)
    upload(context)
    clean(context)


def upload(context: Context) -> None:
    """Run `uv publish` over `dist/`, in the mode the credentials select. See `publish`."""
    if publishes_with_credentials():
        print('UV_PUBLISH_* credentials set — publishing with them, without attestations.')
        command = 'uv publish --trusted-publishing never --no-attestations'
    elif all(os.environ.get(var) for var in OIDC_ENV_VARS):
        print('OIDC token present — publishing through PyPI Trusted Publishing.')
        command = 'uv publish --trusted-publishing always'
    else:
        print(
            f'No way to authenticate: set {", ".join(UV_PUBLISH_SETTINGS)}, or run in a CI job\n'
            f'that mints an OIDC token ({", ".join(OIDC_ENV_VARS)}) for PyPI Trusted Publishing.\n'
            'See docs/developer/how-to/set-up-trusted-publishing.md.'
        )
        raise SystemExit(1)
    execute(context, command)


NO_PREVIOUS_TIP = '0' * 40


def project_version(pyproject: str = '') -> str:
    """Return `[project].version` from `pyproject`'s text, or from the working tree's file."""
    text = pyproject or Path('pyproject.toml').read_text(encoding='utf-8')
    return tomllib.loads(text)['project']['version']


def version_at(context: Context, revision: str) -> str:
    """Return `[project].version` as committed at `revision`."""
    shown = context.run(f'git show {revision}:pyproject.toml', hide=True, warn=True)
    if shown.failed:
        print(f'Could not read pyproject.toml at {revision}:\n{shown.stderr.strip()}')
        raise SystemExit(1)
    return project_version(shown.stdout)


def commit_sha(context: Context, revision: str = 'HEAD') -> str:
    """Return the full sha `revision` resolves to."""
    resolved = context.run(f'git rev-list --max-count=1 {revision}', hide=True, warn=True)
    if resolved.failed:
        print(f'Could not resolve {revision}:\n{resolved.stderr.strip()}')
        raise SystemExit(1)
    return resolved.stdout.strip()


def released_version(context: Context, before: str, after: str) -> tuple[str, str] | None:
    """Return the release tag and commit if the push ``before..after`` bumped the version.

    A release is a change of `[project].version` between the branch tip before the push and
    the tip after it; the tag is derived from the new version and the release is the new tip
    itself, whichever way the release branch was merged. ``before`` all zeros is a push that
    created the branch, which carries no release: there is no earlier version to have bumped
    from. ``before`` empty means there is no previous tip to diff against (a manual run), and
    the tip is compared with its own parent.
    """
    after_sha = commit_sha(context, after or 'HEAD')
    if before == NO_PREVIOUS_TIP:
        return None
    old = version_at(context, before or f'{after_sha}^')
    new = version_at(context, after_sha)
    if old == new:
        return None
    return f'v{new}', after_sha


def record_outputs(output: str, tag: str, sha: str) -> None:
    """Append ``tag=`` and ``sha=`` lines to ``output``, the file a pipeline reads outputs from."""
    if output:
        with Path(output).open('a', encoding='utf-8') as handle:
            handle.write(f'tag={tag}\nsha={sha}\n')


@task
@logged('release.detect')
def detect(context: Context, before: str = '', after: str = '', output: str = '') -> None:
    """Report whether the push ``before..after`` carried a release, and which commit it is.

    What the pipeline asks before deploying anything that should only follow a release, such
    as the documentation site. Always exits 0: no release is an answer, not a failure.

    Args:
        context: Invoke context.
        before: The branch tip before the push (``github.event.before``, ``CI_COMMIT_BEFORE_SHA``).
        after: The branch tip after the push (``github.sha``, ``CI_COMMIT_SHA``); ``HEAD`` if empty.
        output: A file to append ``tag=`` and ``sha=`` lines to (``$GITHUB_OUTPUT``), empty
            values when there is no release, so a later step can read them either way.

    """
    found = released_version(context, before, after)
    tag, sha = found or ('', '')
    print(f'Release {tag} detected at {sha}.' if found else 'No version bump on the incoming commits.')
    record_outputs(output, tag, sha)


@task(name='tag')
@logged('release.tag')
def tag_release(context: Context, revision: str = '') -> None:
    """Create the release tag for the committed version, through the host's Release API.

    The tag is `v<version>` from `pyproject.toml` at ``revision`` (``HEAD`` by default), created
    on the host with the token the pipeline already holds, so no job needs push access to the
    repository. It arrives with a Release entry on the host's releases page.

    Idempotent for a re-run: a tag already on this commit is reported and kept. A tag on a
    different commit is an error, because moving it would change what an existing release
    means.

    Args:
        context: Invoke context.
        revision: The commit to tag; ``HEAD`` if empty.

    """
    sha = commit_sha(context, revision or 'HEAD')
    tag = f'v{version_at(context, sha)}'
    existing = release_tag_commit(context, tag)
    if existing == sha:
        print(f'{tag} already marks {sha}; nothing to create.')
        return
    if existing:
        print(f'{tag} exists on {existing}, not on {sha}. A tag is never moved; delete it first if that is wrong.')
        raise SystemExit(1)
    url = create_release(context, tag, sha)
    if not url:
        raise SystemExit(1)
    print(f'Created {tag} on {sha}: {url}')


@task
@logged('release.ship')
def ship(context: Context, before: str = '', after: str = '', output: str = '') -> None:
    """Publish from CI if the push ``before..after`` carried a release; otherwise do nothing.

    The one command the publish job runs on every push to the default branch. A release is a
    version bump arriving on that branch, so merging the release request any way — merge
    commit, squash, rebase — publishes it. With no bump it prints why and exits 0, so the
    pipeline stays green. With one it tags the new tip through the host's API, then runs
    ``release.dist``, ``release.attest`` and the upload over it. ``dist/`` is left in place for
    anything the pipeline attests afterwards.

    Args:
        context: Invoke context.
        before: The branch tip before the push (``github.event.before``, ``CI_COMMIT_BEFORE_SHA``).
        after: The branch tip after the push (``github.sha``, ``CI_COMMIT_SHA``); ``HEAD`` if empty.
        output: As for ``release.detect``.

    """
    found = released_version(context, before, after)
    tag, sha = found or ('', '')
    record_outputs(output, tag, sha)
    if found is None:
        print('No version bump on the incoming commits; nothing to publish.')
        return
    print(f'Release {tag} detected at {sha}.')
    if commit_sha(context) != sha:
        execute(context, f'git checkout --quiet {sha}')
    tag_release(context, revision=sha)
    dist(context)
    attest(context)
    upload(context)


def resolve_next_version(context: Context, increment: str) -> str:
    """Project the next version via ``cz bump --dry-run`` and parse it out.

    Raises SystemExit if the increment is invalid or cz output cannot be parsed.
    """
    valid = SEMVER_TYPES + PRERELEASE_TYPES
    if increment not in valid:
        print('Usage: ./workflow.cmd release -i <increment>')
        print(f'  increment: {", ".join(valid)}')
        raise SystemExit(1)
    if increment in PRERELEASE_TYPES:
        cmd = f'uv run cz bump --increment patch --prerelease {increment} --allow-no-commit --yes --dry-run'
    else:
        cmd = f'uv run cz bump --increment {increment} --allow-no-commit --yes --dry-run'
    result = context.run(cmd, hide=True, warn=True)
    if result.failed:
        print('Could not determine the next version (cz bump --dry-run failed).')
        print(result.stdout)
        print(result.stderr)
        raise SystemExit(1)
    output = f'{result.stdout}\n{result.stderr}'
    match = re.search(r'tag to create:\s*v?(\S+)', output)
    if match is None:
        match = re.search(r'bump:\s*version\s*\S+\s*\S+\s*(\S+)', output)
    if match is None:
        print('Could not parse the next version from cz bump --dry-run output:')
        print(output)
        raise SystemExit(1)
    return match.group(1)


def abort_if_ref_exists(
    kind: str, name: str, retry_hint: str, *, has: tuple[bool, bool], delete: tuple[str, str]
) -> None:
    """Print where `name` already exists and abort, naming the commands that remove it.

    The two calls in `ensure_refs_are_free` share this exact shape (check local, check origin,
    report both, name the fix) and differ only in the ref kind and the delete commands. `has`
    and `delete` are each `(local, remote)`, mirroring the two-sided check the body makes.
    """
    local_has, remote_has = has
    if not (local_has or remote_has):
        return
    delete_local, delete_remote = delete
    locations = []
    if local_has:
        locations.append('locally')
    if remote_has:
        locations.append('on origin')
    print(f'{kind} `{name}` already exists {" and ".join(locations)}. {retry_hint}')
    if remote_has:
        print(f'  {delete_remote}')
    if local_has:
        print(f'  {delete_local}')
    raise SystemExit(1)


def ensure_refs_are_free(context: Context, new_version: str, release_branch: str) -> None:
    """Abort before any git mutation if the target tag or branch already exists.

    Checks both local and origin copies so a stale ref on either side halts the release
    cleanly. The tag is checked even though nothing here creates it: CI will, on the default
    branch, and a tag that already exists elsewhere would make that step refuse.
    """
    tag_ref = f'v{new_version}'
    local_tag = context.run(f'git tag --list {tag_ref}', hide=True, warn=True)
    remote_tag = context.run(f'git ls-remote --tags origin refs/tags/{tag_ref}', hide=True, warn=True)
    abort_if_ref_exists(
        'Tag',
        tag_ref,
        'Bump to a different version, or remove the tag everywhere before retrying:',
        has=(
            bool(local_tag.stdout.strip()),
            bool(remote_tag.stdout.strip()),
        ),
        delete=(f'git tag -d {tag_ref}', f'git push origin :refs/tags/{tag_ref}'),
    )

    local_branch = context.run(f'git show-ref --verify --quiet refs/heads/{release_branch}', hide=True, warn=True)
    remote_branch = context.run(f'git ls-remote --heads origin refs/heads/{release_branch}', hide=True, warn=True)
    abort_if_ref_exists(
        'Branch',
        release_branch,
        'Remove it everywhere before retrying:',
        has=(
            not local_branch.failed,
            bool(remote_branch.stdout.strip()),
        ),
        delete=(f'git branch -D {release_branch}', f'git push origin --delete {release_branch}'),
    )


@task
@logged('release')
def release(context: Context, increment: str = '', no_push: bool = False) -> None:
    """Prepare a release on a new ``release/<version>`` branch.

    Validates a clean tree on ``main``, branches off, bumps the version, commits the
    changelog, and pushes the branch so the resulting pull request carries the full release
    snapshot for review. No tag is created here: once the request is merged, CI sees the
    version bump arrive on ``main``, creates the tag there, and publishes (``release.ship``).

    Args:
        context: Invoke context.
        increment: Version increment type — major, minor, patch, alpha, beta, or rc.
        no_push: Skip the push step, so the release branch stays local.

    """
    validate(context)

    current = context.run('git rev-parse --abbrev-ref HEAD', hide=True, warn=True)
    if current.failed:
        print('Could not determine the current branch.')
        raise SystemExit(1)
    current_branch = current.stdout.strip()
    if current_branch != 'main':
        print(f'Releases must start from `main` (currently on `{current_branch}`).')
        raise SystemExit(1)

    new_version = resolve_next_version(context, increment)
    release_branch = f'release/{new_version}'
    ensure_refs_are_free(context, new_version, release_branch)

    execute(context, f'git checkout -b {release_branch}')
    bump(context, increment=increment)
    changelog(context, write=True, version=new_version)

    if no_push:
        print(f'Skipping push. Branch `{release_branch}` stays local.')
        return

    execute(context, f'git push -u origin {release_branch}')

    pr_url = create_release_pr(context, release_branch, new_version)
    if pr_url:
        print()
        print(f'Release pull request opened: {pr_url}')
        return
    manual_url = pr_create_url(context, release_branch)
    if manual_url:
        print()
        print(f'Open the release pull request manually: {manual_url}')


@task
@logged('release.clean')
def clean(context: Context) -> None:  # noqa: ARG001
    """Remove build artifacts (``dist/`` and the package-data SBOM)."""
    if Path('dist').exists():
        shutil.rmtree('dist')
        print('Removed dist/')
    if SBOM_FILE.exists():
        SBOM_FILE.unlink()
        print(f'Removed {SBOM_FILE}')


namespace = Collection('release')
namespace.add_task(cast(Task, release), default=True, name='all')
namespace.add_task(cast(Task, validate))
namespace.add_task(cast(Task, bump))
namespace.add_task(cast(Task, changelog))
namespace.add_task(cast(Task, dist))
namespace.add_task(cast(Task, attest))
namespace.add_task(cast(Task, publish))
namespace.add_task(cast(Task, detect))
namespace.add_task(cast(Task, tag_release), name='tag')
namespace.add_task(cast(Task, ship))
namespace.add_task(cast(Task, clean))
