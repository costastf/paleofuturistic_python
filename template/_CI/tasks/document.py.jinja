"""Documentation task definitions."""

import re
from functools import partial
from pathlib import Path
from typing import cast

from invoke import Collection, Context, Task, task

{% if integrate_pages and git_hosting_service == 'github' -%}
from .github import request_pages_build
{% endif -%}
from .quality import update_pyscn_badge
from .shared import execute, execute_with_input, is_ci, logged, open_command, run, run_steps
from .test import update_coverage_badge

DEVELOPER_NAV_START = '# developer-docs:start'
DEVELOPER_NAV_END = '# developer-docs:end'


def properdocs_config_without_developer_docs() -> str:
    """Return `properdocs.yml` with the Developer nav block and its pages excluded.

    Strips the block between the ``developer-docs`` sentinel comments and appends
    ``exclude_docs`` so the underlying pages are dropped from the build entirely,
    not just unlinked from the nav.
    """
    lines = Path('properdocs.yml').read_text(encoding='utf-8').splitlines(keepends=True)
    try:
        start = next(i for i, line in enumerate(lines) if DEVELOPER_NAV_START in line)
        end = next(i for i, line in enumerate(lines) if DEVELOPER_NAV_END in line)
    except StopIteration:
        print(f'properdocs.yml is missing the {DEVELOPER_NAV_START}/{DEVELOPER_NAV_END} markers.')
        raise SystemExit(1) from None
    config = ''.join(lines[:start] + lines[end + 1 :])
    return f'{config}\nexclude_docs: |\n  developer/*\n'


def run_properdocs(context: Context, args: str, *, developer_docs: bool) -> None:
    """Run `properdocs <args>`, optionally with the Developer docs excluded."""
    if developer_docs:
        execute(context, f'uv run properdocs {args}')
    else:
        execute_with_input(context, f'uv run properdocs {args} -f -', properdocs_config_without_developer_docs())


def update_package_version_badge() -> None:
    """Update the package version badge in README.md from pyproject.toml."""
    readme = Path('README.md')
    pyproject = Path('pyproject.toml')
    if not readme.exists() or not pyproject.exists():
        return
    match = re.search(r'^version\s*=\s*"([^"]+)"', pyproject.read_text(encoding='utf-8'), re.MULTILINE)
    if not match:
        return
    version = match.group(1)
    content = readme.read_text(encoding='utf-8')
    updated = re.sub(
        r'(\[!\[Version\]\(https://img\.shields\.io/badge/version-)[^)]+(\))',
        rf'\g<1>{version}-blue\2',
        content,
    )
    if updated != content:
        readme.write_text(updated, encoding='utf-8')
        print(f'Updated version badge to {version}.')


def update_python_badge() -> None:
    """Update the Python version badge in README.md from pyproject.toml classifiers."""
    readme = Path('README.md')
    pyproject = Path('pyproject.toml')
    if not readme.exists() or not pyproject.exists():
        return
    versions = re.findall(
        r'"Programming Language :: Python :: (\d+\.\d+)"',
        pyproject.read_text(encoding='utf-8'),
    )
    if not versions:
        return
    label = '%20%7C%20'.join(versions)
    content = readme.read_text(encoding='utf-8')
    updated = re.sub(
        r'(\[!\[Python\]\(https://img\.shields\.io/badge/python-)[^)]+(\))',
        rf'\g<1>{label}-blue?logo=python&logoColor=white\2',
        content,
    )
    if updated != content:
        readme.write_text(updated, encoding='utf-8')
        print(f'Updated Python badge to {" | ".join(versions)}.')


@task
@logged('document.build')
def build(context: Context, developer_docs: bool = True) -> None:
    """Build the documentation.

    Pass --no-developer-docs to exclude the Developer section (its pages and nav
    entry) — for a release-facing build with no mention of the development workflow.
    """
    run_properdocs(context, 'build --strict', developer_docs=developer_docs)


@task
@logged('document.serve')
@run('uv run properdocs serve')
def serve(context: Context) -> None:
    """Serve the documentation locally with live reload. Ctrl-C to stop."""


@task
@logged('document.view')
def view(context: Context) -> None:
    """Open the built documentation in the default browser. Skipped in CI."""
    if is_ci():
        return
    execute(context, f'{open_command()} site/index.html')
{%- if integrate_pages and git_hosting_service == 'github' %}


@task
@logged('document.deploy-github')
def deploy_github(context: Context, developer_docs: bool = True) -> None:
    """Build the docs, push them to the `gh-pages` branch, and request the Pages build.

    Pass --no-developer-docs to publish without the Developer section.
    """
    run_properdocs(context, 'gh-deploy --force', developer_docs=developer_docs)
    request_pages_build(context)
{%- endif %}


@task
@logged('document')
def document(context: Context, developer_docs: bool = True) -> None:
    """Build and open the documentation; reports all failures before exiting.

    Pass --no-developer-docs to exclude the Developer section from the build.
    """
    update_package_version_badge()
    update_python_badge()
    update_coverage_badge()
    update_pyscn_badge()
    run_steps(partial(build, developer_docs=developer_docs), view)(context)


namespace = Collection('document')
namespace.add_task(cast(Task, document), default=True, name='all')
namespace.add_task(cast(Task, build))
namespace.add_task(cast(Task, serve))
namespace.add_task(cast(Task, view))
{%- if integrate_pages and git_hosting_service == 'github' %}
namespace.add_task(cast(Task, deploy_github), name='deploy-github')
{%- endif %}
