"""Test task definitions."""

import json
import math
import re
import sys
from pathlib import Path
from typing import cast

if sys.version_info >= (3, 11):
    import tomllib
else:
    import tomli as tomllib

from invoke import Collection, Context, Task, task

from .shared import apply_badge, execute, logged, note, open_target, run_steps

COVERAGE_REPORT = Path('reports/coverage.json')
PYPROJECT = Path('pyproject.toml')
SCAFFOLD_TEST_FILE = Path('tests/test_{{ project_slug }}.py')
SCAFFOLD_MARKER = 'def test_sanity'


def coverage_color(pct: float) -> str:
    """Return a badge color for a coverage percentage."""
    if pct >= 90:
        return 'brightgreen'
    if pct >= 80:
        return 'green'
    if pct >= 70:
        return 'yellow'
    if pct >= 60:
        return 'orange'
    return 'red'


def read_coverage_pct() -> int | None:
    """Return the floored total coverage percentage from the latest pytest-cov JSON report.

    Floored, not rounded: this value becomes the ratchet's `fail_under`, and rounding up
    can write a bar the very run that produced it doesn't clear. The badge rounds for
    display in `update_coverage_badge`; a gate must never exceed measured coverage.
    """
    if not COVERAGE_REPORT.exists():
        return None
    try:
        report = json.loads(COVERAGE_REPORT.read_text(encoding='utf-8'))
        return math.floor(report['totals']['percent_covered'])
    except (TypeError, ValueError, KeyError):
        return None


def scaffold_is_pristine() -> bool:
    """Return True iff the scaffolded smoke test `test_sanity` is still in the project.

    The presence of `def test_sanity` in ``tests/test_<slug>.py`` is the signal that the user
    hasn't started writing real tests yet. While it's there, the ratchet stays dormant so
    a 100%-coverage scaffold doesn't lock new development out of the build.
    """
    return SCAFFOLD_TEST_FILE.exists() and SCAFFOLD_MARKER in SCAFFOLD_TEST_FILE.read_text(encoding='utf-8')


def ratchet_fail_under(*, write: bool = True) -> str | None:
    """Bump ``fail_under`` in pyproject.toml after a green test run, gated on the scaffold signal.

    In ``auto-detect`` mode (the default), the ratchet is dormant while the scaffolded
    ``test_sanity`` is still present in ``tests/test_<slug>.py``. The moment the user removes
    that function — i.e., the moment they replace the scaffold with real tests — the ratchet
    engages and behaves strictly: it bumps ``fail_under`` upward to the latest coverage
    percentage and never lets it drop. Once any non-zero ``fail_under`` is written, the
    dormancy gate never closes again, regardless of whether ``test_sanity`` reappears.

    In ``strict`` mode (set ``[tool.test-ratchet] mode = "strict"`` in pyproject.toml), the
    gate is bypassed and the ratchet engages immediately on run #1.

    Every invocation prints a single status line so the user can tell at a glance whether the
    ratchet is dormant, just bumped, or holding steady.

    Args:
        write: Update pyproject.toml. When False, report what would change and touch nothing,
            which is how ``preflight`` gates a push on a bump nobody committed.

    Returns:
        None when ``fail_under`` is already where it belongs, else a one-line reason it is not.
    """
    pct = read_coverage_pct()
    if pct is None:
        return f'no usable coverage report at {COVERAGE_REPORT} — run ./workflow.cmd test'

    # No pyproject.toml, or no `fail_under` in it, means there is no ratchet to move — not a
    # staleness anyone can act on, so both read as up to date.
    content = PYPROJECT.read_text(encoding='utf-8') if PYPROJECT.exists() else ''
    match = re.search(r'^fail_under\s*=\s*(\d+)', content, re.MULTILINE)
    if not match:
        return None
    current = int(match.group(1))

    try:
        ratchet_config = tomllib.loads(content).get('tool', {}).get('test-ratchet', {})
    except tomllib.TOMLDecodeError:
        ratchet_config = {}
    mode = ratchet_config.get('mode', 'auto-detect')

    if mode == 'auto-detect' and current == 0 and scaffold_is_pristine():
        print(f'[ratchet] coverage={pct}% — scaffold still pristine (test_sanity present); ratchet dormant')
        print(f'[ratchet]   ratchet engages when you remove `test_sanity` in {SCAFFOLD_TEST_FILE}')
        print('[ratchet]   to engage immediately, set [tool.test-ratchet] mode = "strict" in pyproject.toml')
        return None

    if pct <= current:
        print(f'[ratchet] coverage={pct}% — fail_under stays at {current}')
        return None
    # Anchored to the start of a line so the bar in `[tool.coverage.report]` is the only
    # `fail_under` this can reach; a `fail_under` inside a docstring or comment is indented.
    reason = apply_badge(
        PYPROJECT,
        r'^fail_under\s*=\s*\d+',
        f'fail_under = {pct}',
        label='coverage ratchet',
        detail=f'fail_under = {pct} (was {current})',
        write=write,
        flags=re.MULTILINE,
        announce=False,
    )
    if write:
        print(f'[ratchet] coverage={pct}% — fail_under bumped {current} → {pct}')
    return reason


def update_coverage_badge(*, write: bool = True) -> str | None:
    """Bring the README's coverage badge in line with the latest coverage report.

    Args:
        write: Update README.md. When False, report what would change and touch nothing.

    Returns:
        None when the badge is already right, else a one-line reason it is not.
    """
    if not COVERAGE_REPORT.exists():
        return f'no coverage report at {COVERAGE_REPORT} — run ./workflow.cmd test'
    try:
        report = json.loads(COVERAGE_REPORT.read_text(encoding='utf-8'))
        pct = round(report['totals']['percent_covered'])
    except (ValueError, KeyError):
        return f'{COVERAGE_REPORT} holds no total coverage — run ./workflow.cmd test'
    color = coverage_color(pct)
    return apply_badge(
        Path('README.md'),
        r'(\[!\[Coverage\]\(https://img\.shields\.io/badge/coverage-)[^)]+(\))',
        rf'\g<1>{pct}%25-{color}\2',
        label='coverage badge',
        detail=f'{pct}%',
        write=write,
    )


@task
@logged('test.pytest')
def pytest(context: Context, args: str = '') -> None:
    """Run pytest on the active interpreter.

    Args:
        context: Invoke context.
        args: Extra arguments forwarded verbatim to pytest, e.g.
            ``--args="-k test_hello"`` or ``--args="-m 'not slow'"``.
    """
    execute(context, f'uv run pytest {args}'.rstrip())


@task
@logged('test.coverage')
def coverage(context: Context) -> None:
    """Show coverage in the terminal and render the browsable report.

    Whatever the last run measured: one interpreter after `test.pytest`, the union across the
    matrix after `test.tox`. The HTML report comes from here; `preflight` produces only the
    JSON it reads, nothing in a gate opening a report.

    No badge is written or commented on. The badge means coverage across the whole matrix,
    while this reports whatever is in the data file, so it cannot tell whether the badge is
    stale. `test.tox` is the command whose number *is* the badge's.
    """
    # `--fail-under=0` throughout: this reports, it does not gate. The floor is enforced once,
    # by `combine_coverage`, against the combined data it was measured from.
    execute(context, 'uv run coverage report --fail-under=0')
    execute(context, f'uv run coverage json -o {COVERAGE_REPORT} --fail-under=0')
    execute(context, 'uv run coverage html -d reports/coverage --fail-under=0')


@task
@logged('test.view')
def view(context: Context) -> None:
    """Run the tests and open the HTML test and coverage reports in a browser.

    Both reports are produced here, by the command that opens them. A plain run writes only
    the JSON the gate reads: rendering HTML nobody looks at is most of a scaffold's test run.
    """
    execute(context, 'uv run pytest --html=reports/tests.html --self-contained-html')
    coverage(context)
    open_target(context, 'reports/tests.html')
    open_target(context, 'reports/coverage/index.html')


def erase_coverage_data() -> None:
    """Delete every coverage data file, the per-env ones included.

    `coverage erase` removes the base `.coverage` and, unless parallel mode is configured,
    nothing else — verified against coverage 7, where a planted `.coverage.py39` survived it
    and was combined by the next run. A data file left by an env since dropped from `env_list`
    would inflate the union, and with it the ratchet's `fail_under`, which only moves up.

    `.coverage.*` cannot match `.coveragerc`, there being no dot before `rc`.
    """
    for data_file in (Path('.coverage'), *Path().glob('.coverage.*')):
        data_file.unlink(missing_ok=True)


def combine_coverage(context: Context) -> None:
    """Merge the matrix's per-env coverage data into one report.

    ``coverage combine`` takes the *union* of the lines each interpreter executed: a line counts
    as covered if any env ran it, which is the only correct reading of a version matrix.
    Version-gated code makes it obvious:

        if sys.version_info >= (3, 11):
            import tomllib
        else:
            import tomli as tomllib

    Under py310 the ``else`` runs; under py311+ the ``if`` does. No single env covers both, so
    each reports a miss on code the matrix as a whole exercises fully — reading one env's report
    understates coverage on exactly the code a five-interpreter matrix exists to test.

    Averaging the per-env percentages would be meaningless: coverage is not a noisy measurement
    of one quantity, it is the set of lines that ran.

    The union does not tell you that a line reached only under py314 works under py310. Coverage
    measures reach, not correctness; the tests check the latter on all five.

    ``[tool.coverage.paths]`` is what makes this possible: each env installs the package into
    its own site-packages, and that mapping folds those paths back onto ``src/``.

    "Combined 4 files, skipped 1" is coverage deduplicating on the sha3 of the *data file*
    rather than on what it measured — `DataFileClassifier` skips a hash it has already
    combined. Where every env measures the same lines some of the SQLite files come out
    byte-identical and the rest differ only in row and page layout. Nothing is lost: a skipped
    file's measurements are already merged, and an env that measured something unique cannot
    hash the same as another.
    """
    # JSON only. The gate produces what the gate consumes: `reports/coverage.json` is what the
    # badge and the ratchet read, and an HTML report has no reader in a hook or a pipeline.
    # `test.coverage` renders one on demand.
    #
    # Not `--keep`: left in place, the per-env files still look like parallel data to coverage,
    # so the next `coverage json` combines them again and says so a second time. Nothing is
    # lost by consuming them — the per-env *reports* under `reports/` are what anyone reads to
    # see one interpreter's numbers.
    execute(context, 'uv run coverage combine')
    # The one place `fail_under` is enforced. Every other coverage command in this workflow
    # passes `--fail-under=0`, and `addopts` does too, because they see one interpreter's data
    # while the floor is set from the union — a floor from the union is unreachable per env.
    execute(context, f'uv run coverage json -o {COVERAGE_REPORT}')


@logged('test.matrix')
def tox_matrix(context: Context, env: str = '') -> None:
    """Run the matrix and combine its coverage, touching no derived value.

    The gate's path, and why there are two: `preflight` runs this, and `preflight` without
    `--write` must write nothing tracked, while the `test.tox` task reports on the coverage
    badge and can write it. `quality.pyscn-analyze` and `pyscn_json_report` split likewise.

    Args:
        context: Invoke context.
        env: A single tox environment to run, e.g. ``py313``. Empty runs the whole matrix.
    """
    # By hand, because `coverage erase` leaves the per-env files alone — see the docstring.
    erase_coverage_data()
    # The live progress list comes up one `env: OK ✔ in Xs` line short. Nothing is skipped: it
    # is whichever env finished *last*, whose line is swallowed as the summary prints, so the
    # absent env is the one with the longest duration and it changes between runs.
    # `--parallel-no-spinner` does not help. The summary block below the list is complete.
    execute(context, f'uv run tox run -e {env}' if env else 'uv run tox run-parallel')
    combine_coverage(context)


@task
@logged('test.tox')
def tox(context: Context, env: str = '', write: bool = False) -> None:
    """Run the pytest matrix across supported Python versions via tox.

    The one command whose coverage number *is* the badge's — the badge means coverage across
    every interpreter in `env_list`, which is exactly what this measures — so it may report on
    the badge and, with `--write`, update it.

    Without the flag it says whether the badge and the ratchet still match, and carries on
    regardless: this is not a gate, `preflight` is. The report calls the same function the gate
    calls with `write=False`, so the two cannot disagree about what stale means.

    Args:
        context: Invoke context.
        env: A single tox environment to run, e.g. ``--env=py313``. When omitted, the full
            matrix runs in parallel.
        write: Update the coverage badge and the ratchet from this run. Refused with `--env`,
            since one interpreter's coverage is not what the badge means.
    """
    if env and write:
        print('--write needs the full matrix: the coverage badge means coverage across every')
        print(f'interpreter in env_list, and --env={env} measures one. Drop --env, or use')
        print('`./workflow.cmd preflight --write`.')
        raise SystemExit(1)
    tox_matrix(context, env=env)
    if env:
        # Nothing true can be said about the badge from one interpreter, so nothing is said.
        return
    note(update_coverage_badge(write=write))
    note(ratchet_fail_under(write=write))


@task
@logged('test')
def test(context: Context) -> None:
    """Run all test steps; reports all failures before exiting.

    One interpreter, the one the active virtualenv resolved to. No badge is written or
    commented on: the badge means coverage across `env_list`, which this did not measure.
    `test.tox` measures that; `preflight` fails on a stale badge.
    """
    run_steps(pytest)(context)


namespace = Collection('test')
namespace.add_task(cast(Task, test), default=True, name='all')
namespace.add_task(cast(Task, pytest))
namespace.add_task(cast(Task, coverage))
namespace.add_task(cast(Task, tox))
namespace.add_task(cast(Task, view))
