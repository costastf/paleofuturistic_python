"""GitLab-specific helpers: container registry publish (kaniko), release MR helpers, pipeline SBOM components."""

import base64
import json
import os
import re
import urllib.error
import urllib.request
from collections.abc import Iterator
from http import HTTPStatus
from pathlib import Path
from typing import NamedTuple
from urllib.parse import quote

from invoke import Context

from _CI.info import read as read_info

from .shared import PipelineComponent, RemoteRef, execute, parse_remote_url

CI_FILE = Path('.gitlab-ci.yml')
# Matches inline `image: foo/bar:tag` and the `name: foo/bar:tag` line inside
# block-form `image:` mappings. `$VAR`-style values are excluded by the char
# class — the SBOM only records statically-pinned image references.
IMAGE_PATTERN = re.compile(r'^\s*(?:image|name):\s*"?([A-Za-z0-9._/\-]+):([A-Za-z0-9._\-]+)"?\s*$')


class RegistrySettings(NamedTuple):
    """Container registry credentials and image-prefix for the chosen host."""

    url: str
    user: str
    password_env: str
    image_prefix: str


def registry_settings() -> RegistrySettings:
    """Return the container registry settings the shipped ``build-deps-image`` job pushes with.

    The registry and image path are GitLab's own ``CI_REGISTRY*`` variables. The credentials
    are the project Deploy Token the pipeline file asks for, ``DEPS_IMAGE_USERNAME`` and
    ``DEPS_IMAGE_PASSWORD``, rather than ``CI_REGISTRY_USER``/``CI_REGISTRY_PASSWORD``: some
    registries reject the job token for pushes, and a run of this task by hand should push to
    the same place with the same identity as the pipeline, or the two images drift apart.
    """
    return RegistrySettings(
        url=os.environ['CI_REGISTRY'],
        user=os.environ['DEPS_IMAGE_USERNAME'],
        password_env='DEPS_IMAGE_PASSWORD',  # noqa: S106 — the name of an env var to read, not a credential
        image_prefix=os.environ['CI_REGISTRY_IMAGE'],
    )


def publish_deps_image(context: Context, tag: str) -> str:
    """Build and push the deps image via kaniko. Return a digest-pinned reference.

    kaniko is a daemonless builder that runs entirely in userspace — required
    on GitLab runners that don't allow privileged docker-in-docker or user
    namespaces (which rule out docker, buildah, and podman).

    Every run builds from the repository — there is no reuse-an-existing-tag path
    here — so the image can only ever be what this pipeline just produced.
    ``--digest-file`` reports the digest kaniko pushed, which is what downstream jobs
    pin to; being daemonless, there is no local image to inspect for it afterwards.

    The image is ``<project registry>:deps-<tag>``, the same reference the shipped
    ``build-deps-image`` job builds: a ``-deps`` sub-path is denied on registries that
    restrict deploy tokens to the project root.
    """
    settings = registry_settings()
    image = f'{settings.image_prefix}:deps-{tag}'
    password = os.environ[settings.password_env]
    token = base64.b64encode(f'{settings.user}:{password}'.encode()).decode()
    config = {'auths': {settings.url: {'auth': token}}}
    config_path = Path('/kaniko/.docker/config.json')
    config_path.parent.mkdir(parents=True, exist_ok=True)
    config_path.write_text(json.dumps(config), encoding='utf-8')
    base_image = read_info('info.base-image')
    digest_file = Path('.deps-image-digest')
    execute(
        context,
        f'/kaniko/executor --dockerfile=Dockerfile.deps --context=. '
        f'--destination={image} --build-arg=BASE_IMAGE={base_image} --digest-file={digest_file}',
    )
    digest = digest_file.read_text(encoding='utf-8').strip() if digest_file.exists() else ''
    if not digest.startswith('sha256:'):
        print(f'kaniko reported no digest for {image}; falling back to the tag.')
        return image
    return f'{image.rsplit(":", 1)[0]}@{digest}'


def origin_ref(context: Context) -> RemoteRef:
    """Return the GitLab instance host and project path from `origin`, or empty strings.

    The host comes from the remote instead of being assumed to be gitlab.com. This module
    only ships when GitLab was the chosen host, so whatever instance `origin` points at *is*
    the GitLab instance — including a self-hosted one. Matching gitlab.com literally, as this
    did, returned an empty path off gitlab.com and silently disabled both the manual MR URL
    and the API call, with nothing printed to say why.

    `parse_remote_url` strips the token CI bakes into origin
    (`https://gitlab-ci-token:<token>@host/…`) before parsing.
    """
    remote = context.run('git remote get-url origin', hide=True, warn=True)
    if remote.failed:
        return RemoteRef(host='', path='')
    return parse_remote_url(remote.stdout)


def pipeline_badge(context: Context) -> str:
    """Return the README markdown for GitLab's own pipeline-status badge, or '' if unknown.

    GitLab serves a badge that always reflects the latest pipeline on the default branch, so the
    status needs no writer here. Only the *URL* is derived, from `origin`, and it stops changing
    once written.

    The host comes from `origin` rather than being assumed to be gitlab.com, for the same reason
    as `origin_ref`. An empty string means `origin` is not readable yet, which is not the same
    as a wrong badge.
    """
    origin = origin_ref(context)
    if not origin.host or not origin.path:
        return ''
    return (
        f'[![Pipeline](https://{origin.host}/{origin.path}/badges/main/pipeline.svg)]'
        f'(https://{origin.host}/{origin.path}/-/pipelines)'
    )


def pr_create_url(context: Context, release_branch: str) -> str:
    """Compose the GitLab MR-create URL for a release branch, or '' if origin is unparseable."""
    origin = origin_ref(context)
    if not origin.host or not origin.path:
        return ''
    source = quote(release_branch, safe='')
    return f'https://{origin.host}/{origin.path}/-/merge_requests/new?merge_request[source_branch]={source}'


def create_release_pr(context: Context, release_branch: str, new_version: str) -> str:
    """Open the release merge request via the GitLab API. Return its URL, or '' on failure.

    Requires ``GITLAB_TOKEN`` in the environment — a personal, project, or group access token
    with the ``api`` scope. Uses only the standard library, like the rest of the CI tooling.

    Every failure returns '' rather than raising, so ``release`` falls back to printing the
    manual URL from ``pr_create_url`` and the release still completes.
    """
    token = os.environ.get('GITLAB_TOKEN', '').strip()
    if not token:
        print(
            'GITLAB_TOKEN not set — release MR will not be opened automatically. '
            'Export a token with the `api` scope to have it created for you.'
        )
        return ''
    origin = origin_ref(context)
    if not origin.host or not origin.path:
        print('Could not read a host and project path from the origin remote; cannot open the MR via the API.')
        return ''
    payload = json.dumps(
        {
            'source_branch': release_branch,
            'target_branch': 'main',
            'title': f'chore(release): v{new_version}',
            'description': (
                f'Release v{new_version} prepared by `./workflow.cmd release`. '
                'Merge this MR so the tag lands on main and publish fires in CI.'
            ),
        }
    ).encode('utf-8')
    # The API addresses a project by its URL-encoded path, so every `/` in a (possibly
    # nested) group path has to become %2F — an unencoded path 404s.
    project = quote(origin.path, safe='')
    request = urllib.request.Request(
        f'https://{origin.host}/api/v4/projects/{project}/merge_requests',
        data=payload,
        method='POST',
        headers={'Content-Type': 'application/json', 'PRIVATE-TOKEN': token},
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:  # noqa: S310
            data = json.loads(response.read().decode('utf-8'))
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode('utf-8', errors='replace')[:500]
        print(f'GitLab API returned {exc.code}: {detail}')
        return ''
    except OSError as exc:
        print(f'GitLab API request failed: {exc}')
        return ''
    return data.get('web_url', '')


def release_api(context: Context) -> tuple[str, dict[str, str]]:
    """Return the Releases API prefix for this project and the auth header to call it with.

    In a pipeline the job token is enough: the Releases API is one of the few that accept it,
    which is how GitLab's own release-cli creates tags. By hand, ``GITLAB_TOKEN`` (``api``
    scope) is used instead. Aborts when neither is set.
    """
    if token := os.environ.get('GITLAB_TOKEN', '').strip():
        headers = {'PRIVATE-TOKEN': token}
    elif job_token := os.environ.get('CI_JOB_TOKEN', '').strip():
        headers = {'JOB-TOKEN': job_token}
    else:
        print('Neither GITLAB_TOKEN nor CI_JOB_TOKEN is set: creating the release tag needs one.')
        raise SystemExit(1)
    base = os.environ.get('CI_API_V4_URL', '').strip()
    project = os.environ.get('CI_PROJECT_ID', '').strip()
    if not base or not project:
        origin = origin_ref(context)
        if not origin.host or not origin.path:
            print('Could not read a host and project path from the origin remote; cannot reach the API.')
            raise SystemExit(1)
        base = base or f'https://{origin.host}/api/v4'
        project = project or quote(origin.path, safe='')
    return f'{base}/projects/{project}/releases', headers


def gitlab_api(url: str, headers: dict[str, str], payload: dict | None = None) -> tuple[int, dict]:
    """Call the GitLab API. Return the status and the decoded body (``{}`` on failure).

    A ``404`` comes back as a status rather than an error, because "is there a release of this
    name" is a question with no as its answer. Every other failure prints what the API said
    and returns ``0``, so the caller decides whether that is fatal.
    """
    if not url.startswith('https://'):
        print(f'Refusing to call a non-https API URL: {url}')
        raise SystemExit(1)
    request = urllib.request.Request(  # noqa: S310 — https only, checked above
        url,
        data=json.dumps(payload).encode('utf-8') if payload is not None else None,
        method='POST' if payload is not None else 'GET',
        headers={'Content-Type': 'application/json', **headers},
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:  # noqa: S310
            return response.status, json.loads(response.read().decode('utf-8') or '{}')
    except urllib.error.HTTPError as exc:
        if exc.code == HTTPStatus.NOT_FOUND:
            return exc.code, {}
        detail = exc.read().decode('utf-8', errors='replace')[:500]
        print(f'GitLab API returned {exc.code}: {detail}')
        return 0, {}
    except OSError as exc:
        print(f'GitLab API request failed: {exc}')
        return 0, {}


def release_tag_commit(context: Context, tag: str) -> str:
    """Return the commit the release named `tag` marks, or '' when there is no such release."""
    releases, headers = release_api(context)
    status, data = gitlab_api(f'{releases}/{quote(tag, safe="")}', headers)
    if status == HTTPStatus.NOT_FOUND:
        return ''
    if not status:
        raise SystemExit(1)
    return data.get('commit', {}).get('id', '')


def create_release(context: Context, tag: str, sha: str) -> str:
    """Create a GitLab Release for `tag` at `sha`, which creates the tag. Return its URL, or ''.

    One API call does both: a release whose tag does not exist yet is created from ``ref``.
    The job token is accepted here, so the pipeline needs no project access token and no
    push access to the repository.
    """
    releases, headers = release_api(context)
    status, data = gitlab_api(
        releases,
        headers,
        {
            'name': tag,
            'tag_name': tag,
            'ref': sha,
            'description': f'Release {tag}, published by the publish job. Changelog: `docs/reference/changelog.md`.',
        },
    )
    return data.get('_links', {}).get('self', '') if status else ''


def iter_pipeline_components() -> Iterator[PipelineComponent]:
    """Yield CI pipeline components for inclusion in the SBOM.

    Reads `.gitlab-ci.yml` and emits one entry per `image: <name>:<tag>`
    reference. Deduplicated; tag-less references are skipped because the
    SBOM requires a version field.
    """
    if not CI_FILE.exists():
        return
    seen: set[tuple[str, str]] = set()
    for line in CI_FILE.read_text(encoding='utf-8').splitlines():
        match = IMAGE_PATTERN.match(line)
        if not match:
            continue
        name, tag = match.group(1), match.group(2)
        if (name, tag) in seen:
            continue
        seen.add((name, tag))
        yield PipelineComponent(name=name, version=tag, purl=f'pkg:docker/{name}@{tag}')
